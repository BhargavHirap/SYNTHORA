# Supabase — required for cloud accounts, workspaces and experiment sync.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose this key with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Optional AI provider configuration for evidence briefs.
# Keep provider keys server-side; never use NEXT_PUBLIC_OPENAI_API_KEY.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# If using Vercel AI Gateway for LLM agent simulations, configure this
# in the Vercel project environment settings as a server-only variable.
AI_GATEWAY_API_KEY=
SYNTHORA_LLM_MODEL=
